*.py[cod]
.venv/
.venv-*/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Secrets / env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Large / generated data — datasets are fetched by a documented step, not committed as blobs.
# Commit small teaching datasets deliberately; keep big ones out.
*.csv.gz
*.parquet
*.zip
*.tar.gz
data/raw/
**/datasets/_downloaded/

# Model / training outputs
*.pt
*.pth
*.onnx
*.h5
mlruns/
mlartifacts/
# Fine-tuned transformer checkpoints (safetensors + config + tokenizer files) — regenerate by
# rerunning the chapter's training script; the HF cache (~/.cache/huggingface) is never committed.
**/fine_tuned_model/
**/_trainer_scratch/

# Local MLOps stores (MLflow sqlite, Feast registry/online store)
*.db
*.sqlite
*.sqlite3
**/feast_demo/**/data/
**/feast_demo/**/registry.db
**/.ipynb_checkpoints/

# Reference repos — the owner's other projects, cloned locally as source material only.
# Chapters must REIMPLEMENT self-contained; these are never committed into the book.
reference-repos/
object-detection/
tensorflow-samples/
Python-Refresher-Course/
transfer-training-samples/
Bayesian-Inference/
