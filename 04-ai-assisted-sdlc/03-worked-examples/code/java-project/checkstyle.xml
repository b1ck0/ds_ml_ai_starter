<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Minimal Checkstyle 14.1.0 ruleset for java-project (research/NOTE-SDLC-3-java-gates.md,
  verified 2026-09-02). Deliberately small: a handful of checks a Java engineer already enforces
  by habit (no tabs, no trailing whitespace, a package declaration and Javadoc on every public
  type), wired into `mvn checkstyle:check` so it stops being a habit and starts being a gate.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>

  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="TreeWalker">
    <module name="PackageDeclaration"/>
    <module name="JavadocType">
      <property name="scope" value="public"/>
    </module>
    <module name="UnusedImports"/>
    <module name="EmptyBlock">
      <property name="option" value="text"/>
    </module>
    <module name="NeedBraces"/>
  </module>
</module>
