#!/usr/bin/env ruby
# bin/setup — one command for a fresh clone: install gems, prepare the database, clear stale
# logs/tmp, restart the server if one is already running. Standard `rails new` content (trimmed of
# the default app's browser-launch line, which does not apply to a headless container image).
# NOTE-SDLC-4-ADD2-docker.md §4. Not used by the docker-compose path (bin/docker-entrypoint does the
# equivalent job at container start) — this is for the native macOS path in README.md §2.
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system! "bundle check || bundle install"

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Restarting application server =="
  system! "bin/rails restart"
end
