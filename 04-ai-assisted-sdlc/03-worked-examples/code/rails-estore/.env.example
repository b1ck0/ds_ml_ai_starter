# .env.example — documents every config variable this app reads. Copy to `.env` locally and fill in
# TEST-MODE values only. NEVER put a live key (sk_live_/pk_live_/rk_live_) here or in any file that
# gets committed — .claude/hooks/guard.sh blocks any shell command that contains one, and Brakeman
# plus the reviewer checklist both grep the diff for the same pattern before merge.

# Stripe TEST-mode keys — from https://dashboard.stripe.com/test/apikeys (checked 2026-09-04,
# NOTE-SDLC-4-4-stripe-checkout.md). Test keys are prefixed pk_test_ / sk_test_ and cannot move real
# money.
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Forces PaymentService#create_checkout_session to return a stub response even outside
# Rails.env.test? — set this for a local dev server so no outbound Stripe call is ever made without
# an explicit opt-in. See app/services/payment_service.rb.
STRIPE_STUB=true
