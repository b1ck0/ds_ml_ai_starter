<h1><%= @product.name %></h1>
<p><%= @product.description %></p>
<p>$<%= "%.2f" % @product.price_dollars %></p>

<% if authenticated? %>
  <%= button_to "Add to cart", line_items_path(product_id: @product.id), method: :post %>
<% else %>
  <%= link_to "Sign in to buy", new_session_path %>
<% end %>
