<h1>Вход</h1>

<%= form_with url: session_path, method: :post do |form| %>
  <div>
    <%= form.label :email_address, "Имейл адрес" %>
    <%= form.email_field :email_address, required: true, autofocus: true %>
  </div>
  <div>
    <%= form.label :password, "Парола" %>
    <%= form.password_field :password, required: true %>
  </div>
  <%= form.submit "Вход" %>
<% end %>

<%= link_to "Създайте профил", new_registration_path %>
