<h1>Your cart</h1>

<% if @cart.line_items.none? %>
  <p>Your cart is empty.</p>
<% else %>
  <ul>
    <% @cart.line_items.each do |item| %>
      <li>
        <%= item.quantity %> &times; <%= item.product.name %>
        &mdash; $<%= "%.2f" % (item.subtotal_cents / 100.0) %>
        <%= button_to "Remove", line_item_path(item), method: :delete %>
      </li>
    <% end %>
  </ul>
  <p>Total: $<%= "%.2f" % (@cart.total_cents / 100.0) %></p>
  <%= button_to "Check out", checkout_orders_path, method: :post %>
<% end %>
