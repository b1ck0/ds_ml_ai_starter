# Copy to .env and fill in as chapters need them. NEVER commit the real .env.
# Cloud + LLM credentials are only needed for the Cloud Environment Setup and Agentic Engineering
# chapters; the core Data Science / local ML examples need none of these.

# --- Agentic Engineering ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DATABASE_URL=postgresql://user:pass@localhost:5432/agents   # for the pgvector / MCP examples

# --- Cloud (fill only the one you use) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # Vertex AI / BigQuery ML
# AWS_PROFILE=                                                   # SageMaker / Redshift ML
# AZURE_SUBSCRIPTION_ID=                                         # Azure ML
