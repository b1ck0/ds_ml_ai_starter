# Copy to .env and fill in as chapters need them. NEVER commit the real .env.
# Cloud + LLM credentials are only needed for the Cloud Environment Setup and Agentic Engineering
# chapters; the core Data Science / local ML examples need none of these.

# --- Agentic Engineering ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=       # a current Claude model id (see the Anthropic docs) -- required alongside
#                        # ANTHROPIC_API_KEY for the key-gated LLM steps (mcp_db/llm_client.py,
#                        # rag_pdf/answer.py); never hard-coded in this project's chapters
# OPENAI_API_KEY=
# GOOGLE_API_KEY=        # required for an ADK agent's actual model calls (see Local Environment
#                        # Setup, Section 4) -- ADK reads GOOGLE_API_KEY by default for Gemini models
# DATABASE_URL=postgresql://postgres:postgres@localhost:55432/agentdb   # matches docker-compose.yml
#                        # in Local Environment Setup/code -- port 55432 avoids colliding with a
#                        # Postgres already listening on the default 5432

# --- Cloud (fill only the one you use) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # Vertex AI / BigQuery ML
# AWS_PROFILE=                                                   # SageMaker / Redshift ML
# AZURE_SUBSCRIPTION_ID=                                         # Azure ML
